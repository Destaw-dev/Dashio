PORT=5000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# MongoDB Atlas: get connection string from Atlas → Cluster → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dashio?retryWrites=true&w=majority
# Use .env for the real URI (never commit .env). Encode special chars in password (e.g. @ → %40).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dashio?retryWrites=true&w=majority

# JWT (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
