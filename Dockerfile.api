# API – build from monorepo root (context: .)
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm ci
RUN npm run build --workspace=@dashio/shared
RUN npm run build --workspace=@dashio/api
ENV NODE_ENV=production
EXPOSE 5000
CMD ["node", "apps/api/dist/index.js"]
