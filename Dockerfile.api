# API – build from monorepo root (context: .)
FROM node:20-alpine
WORKDIR /
COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY api api
RUN npm ci
RUN npm run build --workspace=@dashio/shared
RUN npm run build --workspace=@dashio/api
ENV NODE_ENV=production
EXPOSE 7000
CMD ["node", "api/dist/index.js"]
